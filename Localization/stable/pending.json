    },
    {
      "key": "ui.auto.df85db7e2680",
      "source": "Watching %u, none moving yet -- go between light and shade.",
      "source_hash": "b3d18569c33e2f76ff859c6981cb29ff262eeb7407ba1c22384bdf6dba03998d"
    },
    {
      "key": "ui.auto.c47597f65ba6",
