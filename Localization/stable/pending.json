      "source": "Style",
      "source_hash": "7e744141b40ea5501412e42c8b40fd0b05f1608aa2e4073944ccccbd82f24ee8"
    },
    {
      "key": "ui.auto.ef2eb4d3ae8e",
      "source": "The model was trained on finished, sRGB-encoded frames. The upscaler's\noutput is not one: it is linear and open-ended. These decide how it is\nmapped into something the model recognises. A frame the game reports as\nalready tone-mapped is passed over untouched and none of this applies.",
      "source_hash": "1cffb9f71086704c2a95e7adaa92615aa11815b3d39cdc9a29c08f0193dd86a3"
    },
    {
      "key": "ui.auto.6c5f0776088b",
      "source": "White point from",
      "source_hash": "c18257df4c83ff5b77479737b76932bdaa6774701e28eb0146ec24e5fe2d1637"
    },
    {
      "key": "ui.auto.6e5d02ba48f2",
      "source": "Waiting for a frame...",
      "source_hash": "2006c00dee733c844ce21a77cee9668ed80c11dc5050c1ba74ea3db9693fb8b1"
    },
    {
      "key": "ui.auto.6017572ba18a",
      "source": "This game supplies no exposure -- paper white is in use. Try the scan instead.",
      "source_hash": "8f7a6b545fffd9bb1c7ddd632a19d537b8411818bdb41e34ee03ecd27213bb9d"
    },
    {
      "key": "ui.auto.e4de816e87fa",
      "source": "This game supplies an exposure and it is being read.",
      "source_hash": "f4b9113af7a4f8823bdd78a7e5abf5e2d11d2d22e39a8ba1ca976e560d48ff18"
    },
    {
      "key": "ui.auto.84d8fc9e2d7e",
      "source": "Game exposure %.4f  ->  white point %.2f%s",
      "source_hash": "c400c42a785f8ea702e6ef762147ff655fce1a46db5ad93bc249d7e1f479743c"
    },
    {
      "key": "ui.auto.28f73a0090c9",
      "source": "  (held: absent this frame)",
      "source_hash": "fcf0b2343ae35364cfdf001495dc80e780c5928766891fb7c4d3c014869f71a4"
    },
    {
      "key": "ui.auto.b34e5f68455c",
